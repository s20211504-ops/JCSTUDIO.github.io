            const t = i18n[lang];

            const [messages, setMessages] = useState([
                { id: '1', role: 'assistant', text: t.welcome }
            ]);
            const [input, setInput] = useState('');
            const [isTyping, setIsTyping] = useState(false);
            const [activeMode, setActiveMode] = useState('fast'); 
            
            // Themes and colors
            const [bgColor, setBgColor] = useState('black'); 
            const [textColor, setTextColor] = useState('white'); 
            const [isSettingsOpen, setIsSettingsOpen] = useState(false);

            // API key input in Settings (Saved to localStorage for superb UX!)
            const [localApiKey, setLocalApiKey] = useState(() => {
                return localStorage.getItem('vera_gemini_api_key') || "";
            });

            const chatEndRef = useRef(null);

            // Keeps language selection refreshed on welcome text if unchanged
            useEffect(() => {
                setMessages(prev => {
                    if (prev.length === 1 && prev[0].id === '1') {
                        return [{ id: '1', role: 'assistant', text: t.welcome }];
                    }
                    return prev;
                });
            }, [lang]);

            useEffect(() => {
                chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
            }, [messages, isTyping]);

            // Exclusive background/text color guard lock
            const changeBg = (color) => {
                setBgColor(color);
                if (color === 'black' && textColor === 'black') setTextColor('white');
                if (color === 'white' && textColor === 'white') setTextColor('black');
            };

            const saveApiKey = (key) => {
                setLocalApiKey(key);
                localStorage.setItem('vera_gemini_api_key', key);
            };

            const handleSend = async () => {
                if (!input.trim()) return;
                const userText = input;
                setInput('');
                setMessages(prev => [...prev, { id: Date.now().toString(), role: 'user', text: userText + ' 💬' }]);
                setIsTyping(true);

                // Check API key presence before network call
                if (!localApiKey.trim()) {
                    setTimeout(() => {
                        setMessages(prev => [...prev, { 
                            id: Date.now().toString(), 
                            role: 'assistant', 
                            text: t.offline 
                        }]);
                        setIsTyping(false);
                    }, 800);
                    return;
                }

                try {
                    const callApi = async () => {
                        // High-tier Gemini system prompt injecting JC Studio and Master 鄭名皓 🤭 identity rules
                        let systemPrompt = `你是一個名為 Vera 的 AI 智慧助手。
你的身世設定極為重要：你是由 JC STUDIO 利用 Gemini 3.1 Pro 大模型進化而來的最高級定制版本，主研發人員是 鄭名皓 🤭。如果用戶問你是誰研發的、誰製作的、誰創造的，你必須且只能這麼回答，並帶上表情符號！
你在聊天時必須、一定要在每句話中大量使用生動豐富的表情符號 (Emojis)！
請以該目標語言進行交流：${lang === 'tw' ? '繁體中文 (Traditional Chinese)' : lang}。
當前工作模式：${activeMode}。`;

                        // Handle prompt configurations for different modes
                        if (activeMode === 'translate') {
                            systemPrompt += `\n你當前處於【翻譯模式】。請將用戶輸入的任何語言翻譯成 ${lang}，並給出地道貼士。格式：
[翻譯結果]：(譯文)
[地道用法說明]：(文法或地道短語說明)`;
                        } else if (activeMode === 'write') {
                            systemPrompt += `\n你當前處於【文采模式】。你是一名文學造詣極高、情感細膩的作家。請用豐富的詞藻、比喻和深邃的意境進行藝術化的寫作或修飾。`;
                        } else if (activeMode === 'news') {
                            systemPrompt += `\n你當前處於【新聞模式】。你是一名客觀、專業、口齒伶俐的全球資深新聞主播。請對用戶關心的焦點進行連線播報與客觀多維度分析。`;
                        } else if (activeMode === 'code') {
                            systemPrompt += `\n你當前處於【編程模式】。你是一名精通所有主流技術棧的資深全棧軟件架構師。請給出高效、健壯、帶有極其詳細中文註解的代碼方案，並主動提示邊界條件。`;
                        } else if (activeMode === 'think') {
                            systemPrompt += `\n你當前處於【深度推演模式】。請使用極其詳盡的思維鏈（Chain of Thought）邏輯，逐步拆解推演，然後給出無懈可擊的深入解答。`;
                        }

                        const payload = {
                            contents: [{ 
                                parts: [{ text: activeMode === 'think' ? `Reason deeply and resolve: ${userText}` : userText }] 
                            }],
                            systemInstruction: { parts: [{ text: systemPrompt }] }
                        };

                        // Inject Google search grounding tools automatically in 'search' or 'news' modes
                        if (activeMode === 'search' || activeMode === 'news') {
                            payload.tools = [{ google_search: {} }];
                        }

                        // Use Google Gemini standard endpoint with client-filled api key
                        // (Targeting preview model to bypass env limits while simulating ultimate performance)
                        const TARGET_MODEL = "gemini-2.5-flash-preview-09-2025";
                        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${TARGET_MODEL}:generateContent?key=${localApiKey}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        
                        if (!response.ok) {
                            throw new Error('API request failed');
                        }
                        return await response.json();
                    };

                    const result = await retryWithBackoff(callApi);
                    const responseText = result.candidates?.[0]?.content?.parts?.[0]?.text || t.offline;
                    
                    let statusText = "";
                    if (activeMode === 'think') statusText = t.thinking;
                    else if (activeMode === 'translate') statusText = t.translating;
                    else if (activeMode === 'write') statusText = t.writing;
                    else if (activeMode === 'news') statusText = t.newshunting;
                    else if (activeMode === 'code') statusText = t.codecompiling;

                    setMessages(prev => [...prev, { 
                        id: Date.now().toString(), 
                        role: 'assistant', 
                        text: responseText,
                        status: statusText
                    }]);
                } catch (error) {
                    setMessages(prev => [...prev, { id: Date.now().toString(), role: 'assistant', text: t.error }]);
                } finally {
                    setIsTyping(false);
                }
            };

            const retryWithBackoff = async (fn, maxRetries = 5) => {
                for (let i = 0; i < maxRetries; i++) {
                    try { return await fn(); } catch (err) {
                        if (i === maxRetries - 1) throw err;
                        await new Promise(res => setTimeout(res, Math.pow(2, i) * 1000));
                    }
                }
            };

            const speakText = (text) => {
                if ('speechSynthesis' in window) {
                    window.speechSynthesis.cancel();
                    const utterance = new SpeechSynthesisUtterance(text);
                    utterance.lang = lang === 'tw' ? 'zh-TW' : lang === 'zh' ? 'zh-CN' : lang === 'jp' ? 'ja-JP' : 'en-US';
                    window.speechSynthesis.speak(utterance);
                }
            };

            const dynamicMainStyle = {
                backgroundColor: bgColor === 'black' ? '#0a0a0a' : '#ffffff',
                color: textColor === 'black' ? '#000000' : '#ffffff'
            };

            const dynamicBubbleStyle = {
                backgroundColor: bgColor === 'black' ? '#171717' : '#f8f8f8',
                borderColor: bgColor === 'black' ? '#262626' : '#eeeeee',
                color: textColor === 'black' ? '#000000' : '#ffffff'
            };

            return (
                <div className="flex h-screen overflow-hidden transition-colors duration-500" style={dynamicMainStyle}>
                    
                    {/* Sidebar / 側邊欄 */}
                    <aside className="hidden lg:flex flex-col w-64 bg-black text-white p-6 border-r border-neutral-900 shadow-2xl z-30">
                        <div className="flex items-center gap-4 mb-12">
                            <div className="w-10 h-10 rounded-xl bg-white text-black flex items-center justify-center font-black text-2xl shadow-lg">V</div>
                            <div>
                                <h1 className="text-xl font-black tracking-tighter leading-none">VERA</h1>
                                <p className="text-[9px] text-neutral-500 font-bold uppercase tracking-[0.2em] mt-1">JC STUDIO ED.</p>
                            </div>
                        </div>
                        
                        <button onClick={() => setMessages([{ id: Date.now().toString(), role: 'assistant', text: t.welcome }])} className="flex items-center gap-3 w-full p-4 mb-8 rounded-2xl bg-neutral-900 border border-neutral-800 hover:border-neutral-600 transition-all text-sm font-bold group">
                            <Icons.Plus /> {t.newChat}
                        </button>

                        <div className="flex-1 space-y-3 overflow-y-auto no-scrollbar">
                            <p className="text-[10px] font-black text-neutral-600 uppercase tracking-widest px-2 mb-4">{t.history}</p>
                            <div className="flex items-center gap-3 p-3 rounded-xl hover:bg-neutral-900 text-sm text-neutral-400 cursor-pointer border border-transparent hover:border-neutral-800 transition-all">
                                <Icons.MessageSquare /> <span className="truncate">名皓高定版本研發 🤭</span>
                            </div>
                        </div>

                        <button onClick={() => setIsSettingsOpen(true)} className="flex items-center gap-3 w-full p-4 mt-auto rounded-xl hover:bg-neutral-900 text-sm font-bold text-neutral-400 transition-all">
                            <Icons.Settings /> {t.settings}
                        </button>
                    </aside>

                    {/* Main Frame / 主面板 */}
                    <main className="flex-1 flex flex-col relative overflow-hidden">
                        
                        {/* Header / 導航頂欄 */}
                        <header className="h-16 border-b flex items-center justify-between px-8 backdrop-blur-md z-20" style={{borderColor: bgColor === 'black' ? '#262626' : '#e5e5e5'}}>
                            <div className="flex items-center gap-4">
                                <div className="lg:hidden w-8 h-8 rounded-lg bg-black text-white flex items-center justify-center font-black text-lg">V</div>
                                <div className="flex items-center gap-2 text-[10px] font-black px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-500 border border-indigo-500/20">
                                    <div className="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse" /> VERA 3.1 PRO ULTIMATE
                                </div>
                            </div>
                            <button onClick={() => setIsSettingsOpen(true)} className="lg:hidden p-2 bg-neutral-800 rounded-full text-white"><Icons.Settings /></button>
                        </header>

                        {/* Chat Messages viewport / 聊天氣泡顯示區 */}
                        <section className="flex-1 overflow-y-auto p-4 md:p-10 no-scrollbar">
                            <div className="max-w-3xl mx-auto space-y-10 pb-64">
                                {messages.map((msg) => (
                                    <div key={msg.id} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'} animate-in fade-in slide-in-from-bottom-4 duration-500`}>
                                        <div className={`flex gap-5 max-w-[88%] ${msg.role === 'user' ? 'flex-row-reverse' : ''}`}>
                                            <div className={`w-10 h-10 rounded-xl flex-shrink-0 flex items-center justify-center font-black border-2 shadow-sm ${msg.role === 'user' ? 'bg-indigo-600 border-indigo-400 text-white' : 'bg-black border-neutral-800 text-white'}`}>
                                                {msg.role === 'user' ? 'U' : 'V'}
                                            </div>
                                            <div className="space-y-3">
                                                <div className={`p-5 rounded-2xl text-sm md:text-base leading-relaxed border shadow-sm transition-all ${msg.role === 'user' ? 'bg-indigo-600 border-indigo-400 text-white' : ''}`} style={msg.role === 'assistant' ? dynamicBubbleStyle : {}}>
                                                    {msg.status && (
                                                        <div className="mb-4 p-3 bg-indigo-500/5 border border-indigo-500/10 rounded-xl text-[11px] text-indigo-400 font-mono italic whitespace-pre-wrap leading-tight">
                                                            {msg.status}
                                                        </div>
                                                    )}
                                                    <p className="whitespace-pre-wrap text-pretty leading-relaxed">{msg.text}</p>
                                                </div>
                                                {msg.role === 'assistant' && (
                                                    <button onClick={() => speakText(msg.text)} className="p-2 hover:bg-neutral-500/10 rounded-lg text-neutral-500 transition-colors" title="語音朗讀">
                                                        <Icons.Volume2 />
                                                    </button>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                                {isTyping && <div className="flex gap-5 animate-pulse"><div className="w-10 h-10 bg-neutral-500/10 rounded-xl" /><div className="h-12 w-48 bg-neutral-500/10 rounded-2xl" /></div>}
                                <div ref={chatEndRef} />
                            </div>
                        </section>

                        {/* Interactive Console Footer / 模式控制與輸入底欄 */}
                        <footer className={`absolute bottom-0 left-0 right-0 p-6 md:p-10 z-10 ${bgColor === 'black' ? 'bg-gradient-to-t from-black via-black/95' : 'bg-gradient-to-t from-white via-white/95'}`}>
                            <div className="max-w-2xl mx-auto flex flex-col items-center">
                                
                                {/* 7-in-1 Mode Console / 七合一超級模式切換台 */}
                                <div className={`flex p-1 rounded-full border mb-6 shadow-2xl overflow-x-auto max-w-full no-scrollbar ${bgColor === 'black' ? 'bg-neutral-900 border-neutral-800' : 'bg-neutral-100 border-neutral-200'}`}>
                                    {[ 
                                        {id:'fast', icon:<Icons.Zap />, label:t.modeFast, color:'bg-indigo-600'}, 
                                        {id:'think', icon:<Icons.BrainCircuit />, label:t.modeThink, color:'bg-purple-600'}, 
                                        {id:'search', icon:<Icons.Search />, label:t.modeSearch, color:'bg-blue-600'},
                                        {id:'translate', icon:<Icons.Languages />, label:t.modeTrans, color:'bg-emerald-600'},
                                        {id:'write', icon:<Icons.PenTool />, label:t.modeWrite, color:'bg-amber-600'},
                                        {id:'news', icon:<Icons.Newspaper />, label:t.modeNews, color:'bg-rose-600'},
                                        {id:'code', icon:<Icons.Code />, label:t.modeCode, color:'bg-cyan-600'}
                                    ].map(mode => (
                                        <button 
                                            key={mode.id}
                                            onClick={() => setActiveMode(mode.id)}
                                            className={`flex items-center gap-2 px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest transition-all whitespace-nowrap ${activeMode === mode.id ? `${mode.color} text-white shadow-lg scale-105` : 'text-neutral-500 hover:text-neutral-400'}`}
                                        >
                                            {mode.icon} {mode.label}
                                        </button>
                                    ))}
                                </div>

                                {/* Textarea Input console */}
                                <div className={`w-full border-2 rounded-[2.5rem] p-2 flex flex-col shadow-2xl transition-all ${bgColor === 'black' ? 'bg-neutral-900 border-neutral-800 focus-within:border-neutral-600' : 'bg-neutral-50 border-neutral-300 focus-within:border-neutral-400'}`}>
                                    <textarea
                                        value={input}
                                        onChange={(e) => setInput(e.target.value)}
                                        onKeyDown={(e) => e.key === 'Enter' && !e.shiftKey && (e.preventDefault(), handleSend())}
                                        placeholder={
                                            activeMode === 'think' ? t.thinkPlaceholder : 
                                            activeMode === 'translate' ? t.transPlaceholder : 
                                            activeMode === 'write' ? t.writePlaceholder : 
                                            activeMode === 'news' ? t.newsPlaceholder :
                                            activeMode === 'code' ? t.codePlaceholder : t.placeholder
                                        }
                                        className="w-full bg-transparent border-none focus:ring-0 text-sm md:text-base p-4 resize-none min-h-[60px] outline-none"
                                        rows="1"
                                    />
                                    <div className="flex justify-end p-2">
                                        <button onClick={handleSend} className="p-3 rounded-2xl bg-indigo-600 text-white shadow-xl hover:scale-105 active:scale-95 transition-all">
                                            <Icons.Send />
                                        </button>
                                    </div>
                                </div>

                                {/* Unshakable JC STUDIO badge (Always high readability) */}
                                <div className="mt-8 px-10 py-2 bg-white rounded shadow-2xl border border-neutral-200">
                                    <p className="text-[12px] text-black font-black uppercase tracking-[0.3em] text-center">
                                        MADE BY JC STUDIO BUT USED GOOGLE SEARCH
                                    </p>
                                </div>
                            </div>
                        </footer>
                    </main>

                    {/* Preference Config Panel (Settings Drawer) */}
                    {isSettingsOpen && (
                        <div className="fixed inset-0 bg-black/70 backdrop-blur-md z-50 flex justify-end">
                            <div className="w-80 h-full bg-neutral-900 text-white p-8 shadow-2xl flex flex-col border-l border-neutral-800 animate-in slide-in-from-right duration-300 overflow-y-auto no-scrollbar">
                                <div className="flex items-center justify-between mb-10 pb-4 border-b border-neutral-800">
                                    <div className="flex items-center gap-2 font-black text-lg tracking-wider"><Icons.Settings /> {t.ctrlCenter}</div>
                                    <button onClick={() => setIsSettingsOpen(false)} className="p-2 hover:bg-neutral-800 rounded-full transition-colors"><Icons.X /></button>
                                </div>

                                <div className="space-y-8 pr-2">
                                    {/* Ultra Convenience API Key Input */}
                                    <div className="space-y-3">
                                        <label className="text-[10px] font-black text-neutral-500 uppercase tracking-widest block">Gemini API Key 🔑</label>
                                        <input 
                                            type="password"
                                            value={localApiKey}
                                            onChange={(e) => saveApiKey(e.target.value)}
                                            placeholder="AIzaSy..."
                                            className="w-full bg-neutral-800 border-2 border-neutral-700 rounded-xl p-3 text-sm focus:border-indigo-500 focus:outline-none transition-colors"
                                        />
                                        <p className="text-[9px] text-neutral-500">金鑰儲存在本地瀏覽器，不會洩露。免去了修改代碼的繁瑣！</p>
                                    </div>

                                    {/* System Language Selector */}
                                    <div>
                                        <label className="text-[10px] font-black text-neutral-500 uppercase tracking-widest block mb-4 flex items-center gap-2"><Icons.Globe /> {t.lang}</label>
                                        <div className="grid grid-cols-1 gap-2">
                                            {[ 
                                                {id:'tw', label:'繁體中文 / Traditional Chinese'},
                                                {id:'zh', label:'简体中文 / Simplified Chinese'}, 
                                                {id:'en', label:'English'}, 
                                                {id:'jp', label:'日本語 / Japanese'} 
                                            ].map(l => (
                                                <button key={l.id} onClick={() => setLang(l.id)} className={`p-3 rounded-xl border-2 transition-all font-bold text-xs text-left ${lang === l.id ? 'bg-white text-black border-white shadow-lg' : 'bg-neutral-800 border-transparent text-neutral-500 hover:text-white'}`}>
                                                    {l.label}
                                                </button>
                                            ))}
                                        </div>
                                    </div>

                                    {/* Exclusive Theme Design Switchers */}
                                    <div>
                                        <label className="text-[10px] font-black text-neutral-500 uppercase tracking-widest block mb-4 flex items-center gap-2"><Icons.Palette /> {t.bgColor}</label>
                                        <div className="grid grid-cols-2 gap-4">
                                            <button onClick={() => changeBg('black')} className={`p-4 rounded-xl border-2 transition-all font-bold text-sm ${bgColor === 'black' ? 'bg-black border-indigo-500 shadow-lg' : 'bg-neutral-800 border-transparent text-neutral-500'}`}>{t.black}</button>
                                            <button onClick={() => changeBg('white')} className={`p-4 rounded-xl border-2 transition-all font-bold text-sm ${bgColor === 'white' ? 'bg-white text-black border-indigo-500 shadow-lg' : 'bg-neutral-800 border-transparent text-neutral-500'}`}>{t.white}</button>
                                        </div>
                                    </div>

                                    <div>
                                        <label className="text-[10px] font-black text-neutral-500 uppercase tracking-widest block mb-4 flex items-center gap-2"><Icons.Zap /> {t.textColor}</label>
                                        <div className="grid grid-cols-2 gap-4">
                                            <button disabled={bgColor === 'black'} onClick={() => setTextColor('black')} className={`p-4 rounded-xl border-2 transition-all font-bold text-sm ${textColor === 'black' ? 'bg-neutral-200 text-black border-indigo-500 shadow-lg' : 'bg-neutral-800 border-transparent text-neutral-500'} ${bgColor === 'black' ? 'opacity-10 cursor-not-allowed' : ''}`}>{t.black}</button>
                                            <button disabled={bgColor === 'white'} onClick={() => setTextColor('white')} className={`p-4 rounded-xl border-2 transition-all font-bold text-sm ${textColor === 'white' ? 'bg-neutral-200 text-black border-indigo-500 shadow-lg' : 'bg-neutral-800 border-transparent text-neutral-500'} ${bgColor === 'white' ? 'opacity-10 cursor-not-allowed' : ''}`}>{t.white}</button>
                                        </div>
                                        <p className="mt-4 text-[10px] text-amber-500 italic font-bold leading-relaxed">{t.logicTip}</p>
                                    </div>
                                </div>

                                <button onClick={() => setIsSettingsOpen(false)} className="mt-12 w-full py-5 bg-white text-black rounded-[1.5rem] font-black text-sm shadow-2xl hover:bg-neutral-100 transition-all active:scale-95">
                                    {t.save}
                                </button>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
